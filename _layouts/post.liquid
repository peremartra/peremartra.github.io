---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ page.date | date: "%B %-d, %Y" }}
      {% if page.author %} • {{ page.author }}{% endif %}
      {% if page.meta %} • {{ page.meta }}{% endif %}
    </p>
  </header>

  <article class="post-content">
    {{ content }}
  </article>

  <div class="clearfix">
      {% if page.previous %}
      <a class="btn btn-primary float-left" href="{{ page.previous.url | relative_url }}" data-toggle="tooltip" data-placement="top" title="{{ page.previous.title }}">
        &larr; Previous
      </a>
      {% endif %}
      {% if page.next %}
      <a class="btn btn-primary float-right" href="{{ page.next.url | relative_url }}" data-toggle="tooltip" data-placement="top" title="{{ page.next.title }}">
        Next &rarr;
      </a>
      {% endif %}
  </div>
</div>
